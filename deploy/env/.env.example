# ------------------------------------------------------------------------------
# EZBILLZ Production Environment Variables
# ------------------------------------------------------------------------------

# --- Application Setup ---
NODE_ENV="production"
# Generate a strong 32-character string (e.g., using `openssl rand -hex 16`)
ENCRYPTION_KEY="replace-with-a-32-byte-hex-string"
APP_DOMAIN="ezbillz.example.com"

# --- Database ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: Since the app container connects via the docker bridge, use the postgres service name.
REDACTED_SECRET="postgresql://ezbillz:replace_with_strong_password@postgres:5432/ezbillz"
REDACTED_SECRET="postgresql://ezbillz:replace_with_strong_password@postgres:5432/ezbillz"
POSTGRES_USER="ezbillz"
POSTGRES_PASSWORD=REDACTED_SECRET"
POSTGRES_DB="ezbillz"

# --- NextAuth ---
# Must match exactly your public domain with https
REDACTED_SECRET="https://ezbillz.example.com"
# Generate a secret: `openssl rand -base64 32`
REDACTED_SECRET="replace-with-base64-secret"

# --- Storage: MinIO ---
STORAGE_PROVIDER="S3"
S3_BUCKET="ezbillz"
S3_REGION="us-east-1"
# Ensure these match the MINIO_ROOT_USER/PASSWORD provided below
S3_ACCESS_KEY_ID="replace_with_minio_user"
S3_SECRET_ACCESS_KEY="replace_with_minio_password"
S3_ENDPOINT="http://minio:9000"
S3_FORCE_PATH_STYLE="true"

# --- MinIO Service Config ---
# These are used by the MinIO container to set its initial root credentials
MINIO_ROOT_USER="replace_with_minio_user"
MINIO_ROOT_PASSWORD=REDACTED_SECRET"

# --- Backup Config ---
# Number of days to retain backups before deleting
BACKUP_RETENTION_DAYS=7
