# ------------------------------------------------------------------------------
# EZBILLZ Production Environment Variables (EXAMPLE)
# ------------------------------------------------------------------------------

# --- Application Setup ---
NODE_ENV="production"
ENCRYPTION_KEY="CHANGE_ME_TO_A_32_BYTE_BASE64_STRING"
APP_DOMAIN="localhost"

# --- Database ---
DATABASE_URL="postgresql://ezbillz:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/ezbillz"
DIRECT_URL="postgresql://ezbillz:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/ezbillz"
POSTGRES_USER="ezbillz"
POSTGRES_PASSWORD="CHANGE_ME_POSTGRES_PASSWORD"
POSTGRES_DB="ezbillz"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="CHANGE_ME_TO_A_SECURE_SECRET"

# --- Storage: MinIO ---
STORAGE_PROVIDER="S3"
S3_BUCKET="ezbillz"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="ezbillz_minio"
S3_SECRET_ACCESS_KEY="CHANGE_ME_MINIO_PASSWORD"
S3_ENDPOINT="http://minio:9000"
S3_FORCE_PATH_STYLE="true"

# --- MinIO Service Config ---
MINIO_ROOT_USER="ezbillz_minio"
MINIO_ROOT_PASSWORD="CHANGE_ME_MINIO_PASSWORD"

# --- Backup Config ---
BACKUP_RETENTION_DAYS=7
