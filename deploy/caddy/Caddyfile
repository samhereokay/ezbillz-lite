http://{$APP_DOMAIN:localhost} {
    request_body {
        max_size 50MB
    }

    reverse_proxy app:3000 {
        header_up X-Real-IP {remote_host}
        header_up X-Request-ID {http.request.uuid}

        transport http {
            dial_timeout 5s
            response_header_timeout 30s
        }
    }
}
