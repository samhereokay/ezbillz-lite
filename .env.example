# EZBILLZ - Production Environment Template

# --- Database ---
# Server-only. Must use Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/ezbillz"
# Required for serverless deployments (e.g. Vercel)
DIRECT_URL="postgresql://user:password@localhost:5432/ezbillz"

# --- Auth ---
# Server-only. Must be a secure random 32+ char string
NEXTAUTH_SECRET="your-secure-secret-here"
# Public. URL of the app
NEXTAUTH_URL="http://localhost:3000"

# --- Encryption ---
# Server-only. Used for encrypting tokens at rest
ENCRYPTION_KEY="your-secure-encryption-key"

# --- Storage ---
# Valid options: LOCAL, S3
STORAGE_PROVIDER="S3"
LOCAL_STORAGE_DIR="./storage-data" # Only used if STORAGE_PROVIDER=LOCAL

# --- S3 Config (if STORAGE_PROVIDER=S3) ---
# Server-only credentials
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="ezbillz"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_FORCE_PATH_STYLE="true" # Set to false if using AWS S3

# --- Backup Configuration ---
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="7"
